# 🚀 CONFIGURACIÓN DE FIVI

# Puerto donde corre la aplicación
PORT=5000

# Entorno (development o production)
FLASK_ENV=development

# URL de tu API de Render (la que obtiene los datos de ventas)
# IMPORTANTE: Si tienes otra API que proporciona datos, configúrala aquí
RENDER_URL=https://tu-otra-api.onrender.com

# API Key para autenticación con Render (si es necesaria)
RENDER_API_KEY=tu_api_key_aqui

# Ruta de la base de datos (opcional)
# Si no especificas, usa: /tmp/nexus.db
NEXUS_DB_PATH=

# Base de datos remota (si quieres usar PostgreSQL, etc)
# DATABASE_URL=postgresql://user:pass@localhost/fivi
